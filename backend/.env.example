# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/database_name

# Authentication & JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# CORS Allowed Client URLs
FRONTEND_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Email SMTP Credentials (Optional)
NODEMAILER_GMAIL=your_gmail@gmail.com
NODEMAILER_GMAIL_PASS=your_app_password

# Cloudinary Storage Credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
